# 数据库配置
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=articleai
DATABASE_USER=admin
DATABASE_PASSWORD=your_secure_password_here

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# 后端服务
BACKEND_PORT=3000
NODE_ENV=development

# 前端配置
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# 默认AI配置（可选，用户可在系统中配置）
DEFAULT_AI_PROVIDER=claude
DEFAULT_AI_MODEL=claude-sonnet-5
DEFAULT_AI_API_KEY=

# OpenAI配置（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Claude配置（可选）
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# 知网搜索配置（MCP）
CNKI_API_URL=
CNKI_API_KEY=

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# CORS配置
CORS_ORIGIN=http://localhost:5173

# 会话配置
SESSION_TIMEOUT=3600000
MAX_SESSIONS_PER_PROJECT=1

# 任务队列配置
QUEUE_CONCURRENCY=3
QUEUE_MAX_RETRIES=3
